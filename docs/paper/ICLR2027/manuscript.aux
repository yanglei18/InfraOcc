\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {RoadOcc framework.} The image encoder and view transformation construct multi-scale voxel features. At each feature aggregation scale, DCA produces the current observation, VVE fuses current, temporal, and lower-scale flow into dynamic flow, and VDSF routes fixed-coordinate, backwarped, or current evidence to fusion. Coarse-to-fine outputs feed occupancy decoding for semantic occupancy and voxel flow.\relax }}{4}{figure.caption.4}\protected@file@percent }
\newlabel{fig:overview}{{4}{4}{\textbf {RoadOcc framework.} The image encoder and view transformation construct multi-scale voxel features. At each feature aggregation scale, DCA produces the current observation, VVE fuses current, temporal, and lower-scale flow into dynamic flow, and VDSF routes fixed-coordinate, backwarped, or current evidence to fusion. Coarse-to-fine outputs feed occupancy decoding for semantic occupancy and voxel flow.\relax }{figure.caption.4}{}}
