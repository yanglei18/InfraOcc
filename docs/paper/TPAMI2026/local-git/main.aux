\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Comparison of representative 3D perception benchmarks across viewpoint, sensing, and occupancy capabilities.} Among them, InfraOcc is the only real-world benchmark that provides dense semantic occupancy under a fixed roadside viewpoint with unified C/L/C+L evaluation and static/dynamic (S/D) diagnostics. \emph  {Sensor} denotes the roadside/infrastructure-side suite producing benchmark inputs (ego rows show the ego-vehicle suite); cooperative datasets additionally include vehicle agents, as indicated by \emph  {Viewpoint}. C/L/R denote camera, LiDAR, and radar. {\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 51}\xspace  /{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 55}\xspace  /\leavevmode {\color  {gray}$\triangle $}\xspace  denote full/no/partial support.\relax }}{4}{table.caption.2}\protected@file@percent }
\newlabel{tab:dataset_comparison}{{1}{4}{\textbf {Comparison of representative 3D perception benchmarks across viewpoint, sensing, and occupancy capabilities.} Among them, InfraOcc is the only real-world benchmark that provides dense semantic occupancy under a fixed roadside viewpoint with unified C/L/C+L evaluation and static/dynamic (S/D) diagnostics. \emph {Sensor} denotes the roadside/infrastructure-side suite producing benchmark inputs (ego rows show the ego-vehicle suite); cooperative datasets additionally include vehicle agents, as indicated by \emph {Viewpoint}. C/L/R denote camera, LiDAR, and radar. \cmark /\xmark /\pmark denote full/no/partial support.\relax }{table.caption.2}{}}
